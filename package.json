{
  "name": "vibe-knowledge-video-engine",
  "version": "0.1.0",
  "private": true,
  "description": "A cinematic, deterministic Remotion foundation for visual knowledge videos.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:task001": "remotion render src/index.ts Task001Foundation output/task001-foundation.mp4 --codec h264 --crf 18",
    "render:task002": "remotion render src/index.ts Task002VisualSystem output/task002-visual-system.mp4 --codec h264 --crf 18",
    "render:task003": "remotion render src/index.ts Task003ComponentGallery output/task003-component-gallery.mp4 --codec h264 --crf 18",
    "render:task004": "remotion render src/index.ts Task004SceneEngine output/task004-scene-engine.mp4 --codec h264 --crf 18",
    "render:episode": "tsx scripts/render-episode.ts",
    "compose:hybrid": "tsx scripts/render-hybrid.ts",
    "render:hybrid": "tsx scripts/render-hybrid.ts",
    "review:asset": "tsx scripts/review-asset.ts",
    "generate:episode": "tsx scripts/generate-episode.ts",
    "make:episode": "tsx scripts/make-episode.ts",
    "research:episode": "tsx scripts/research-episode.ts",
    "plan:visuals": "tsx scripts/plan-visuals.ts",
    "plan:assets": "tsx scripts/plan-assets.ts",
    "generate:assets": "tsx scripts/generate-assets.ts",
    "library:search": "tsx scripts/library-search.ts",
    "library:list": "tsx scripts/library-list.ts",
    "library:promote": "tsx scripts/library-promote.ts",
    "library:disable": "tsx scripts/library-disable.ts",
    "library:add-curated": "tsx scripts/library-add-curated.ts",
    "library:doctor": "tsx scripts/library-doctor.ts",
    "qa:visual": "tsx scripts/visual-qa.ts",
    "factory": "tsx scripts/factory.ts",
    "factory:v2": "tsx scripts/factory-v2.ts",
    "factory:v2:review": "tsx scripts/factory-v2-review.ts",
    "generate:verified": "tsx scripts/generate-verified.ts",
    "phase2:preflight": "tsx scripts/phase2-preflight.ts",
    "recraft:style-status": "tsx scripts/recraft-style-status.ts",
    "recraft:validate-style": "tsx scripts/validate-recraft-style.ts",
    "recraft:score-style": "tsx scripts/score-recraft-style.ts",
    "recraft:validate-midnight-style": "tsx scripts/validate-midnight-recraft-style.ts",
    "recraft:score-midnight-style": "tsx scripts/score-midnight-recraft-style.ts",
    "validate:episode": "tsx scripts/validate-episode.ts",
    "validate:episodes": "tsx scripts/validate-episodes.ts",
    "test:episodes": "tsx --test src/episode/episode.test.ts",
    "test:ai": "tsx --test tests/generation.test.ts",
    "test": "tsx --test src/episode/episode.test.ts tests/generation.test.ts tests/task007.test.ts tests/task008.test.ts tests/phase2.test.ts tests/assetStrategy.test.ts tests/assetGeneration.test.ts tests/hybridComposer.test.ts tests/assetLibrary.test.ts tests/visualQa.test.ts tests/factoryV2.test.ts",
    "schema:episode": "tsx scripts/generate-episode-schema.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "dotenv": "^18.0.5",
    "openai": "7.27.0",
    "pngjs": "^7.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.532",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.532",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "tsx": "^4.23.15",
    "typescript": "5.9.2"
  }
}
